    "audio": "day01/audio/shift.mp3",
    "duration": 16.439728,
    "frames": 533,
    "speechFrames": 493,
    "captions": [
      {
        "text": "So people asked a new question: can",
        "startFrame": 0,
        "endFrame": 82
      },
      {
        "text": "we show a computer what happened before,",
        "startFrame": 82,
        "endFrame": 164
      },
      {
        "text": "and let it find useful patterns?",
        "startFrame": 164,
        "endFrame": 234
      },
      {
        "text": "We give it examples: these emails were",
        "startFrame": 234,
        "endFrame": 316
      },
      {
        "text": "spam; these were legitimate.",
        "startFrame": 316,
        "endFrame": 363
      },
      {
        "text": "Computers can compare examples and notice",
        "startFrame": 363,
        "endFrame": 434
      },
      {
        "text": "clues that often appear together.",
        "startFrame": 434,
        "endFrame": 493
      }
    ]
  },
  {
