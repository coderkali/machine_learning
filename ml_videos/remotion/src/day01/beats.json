    "audio": "day01/audio/training.mp3",
    "duration": 15.046531,
    "frames": 491,
    "speechFrames": 451,
    "captions": [
      {
        "text": "A suspicious link might matter.",
        "startFrame": 0,
        "endFrame": 53
      },
      {
        "text": "Certain wording might matter.",
        "startFrame": 53,
        "endFrame": 96
      },
      {
        "text": "But no single clue is a perfect",
        "startFrame": 96,
        "endFrame": 171
      },
      {
        "text": "rule.",
        "startFrame": 171,
        "endFrame": 182
      },
      {
        "text": "As the computer sees more examples, it",
        "startFrame": 182,
        "endFrame": 257
      },
      {
        "text": "adjusts its pattern.",
        "startFrame": 257,
        "endFrame": 289
      },
      {
        "text": "That learned pattern is called a model.",
        "startFrame": 289,
        "endFrame": 365
      },
      {
