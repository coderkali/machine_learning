# Instructor-supplied course code — kept on disk for diffing, never pushed.
# Two reasons: (1) this repo is public and the course material isn't mine to
# republish, (2) the friction is the point — see AI_ML_Series/README.md,
# the teacher's code is not opened until my own implementation runs.
_instructor/

# Notebook / Python cruft
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
ml_videos/.venv/
pizza_env/

